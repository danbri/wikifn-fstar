let rec rule_lookup (rules:list case_rule) (c:codepoint) : Tot (option codepoint) =
  match rules with
  | [] -> None
  | (lo, hi, stride, tlo) :: rest ->
      if lo <= c && c <= hi && stride > 0 && (c - lo) % stride = 0
      then Some (tlo + (c - lo))
      else rule_lookup rest c

let rec expansion_lookup (table:list case_expansion) (c:codepoint) : Tot (option (list codepoint)) =
  match table with
  | [] -> None
  | (source, target) :: rest ->
      if source = c then Some target else expansion_lookup rest c

let rec in_ranges (ranges:list case_range) (c:codepoint) : Tot bool =
  match ranges with
  | [] -> false
  | (lo, hi) :: rest -> if lo <= c && c <= hi then true else in_ranges rest c

let is_cased (c:codepoint) : Tot bool = in_ranges cased_ranges c
let is_case_ignorable (c:codepoint) : Tot bool = in_ranges case_ignorable_ranges c

(* ASCII first: the overwhelmingly common case, answered by arithmetic. *)
let upper_one (c:codepoint) : Tot (list codepoint) =
  if c < 97 then [c]
  else if c <= 122 then [c - 32]
  else if c < 181 then [c]
  else match expansion_lookup upper_expansions c with
       | Some target -> target
       | None -> (match rule_lookup upper_runs c with
                  | Some target -> [target]
                  | None -> [c])

let sigma_capital : codepoint = 0x03A3
let sigma_small : codepoint = 0x03C3
let sigma_final : codepoint = 0x03C2

let lower_one_context_free (c:codepoint) : Tot (list codepoint) =
  if c < 65 then [c]
  else if c <= 90 then [c + 32]
  else if c < 0xC0 then [c]
  else match expansion_lookup lower_expansions c with
       | Some target -> target
       | None -> (match rule_lookup lower_runs c with
                  | Some target -> [target]
                  | None -> [c])

(* Final_Sigma, from SpecialCasing.txt: C is preceded by a cased letter
   possibly separated by case-ignorable characters, and is NOT followed by a
   cased letter possibly separated by case-ignorable characters.
   'before' is the input already consumed, most recent first. *)
let rec preceded_by_cased (before:text) : Tot bool =
  match before with
  | [] -> false
  | c :: rest -> if is_cased c then true
                 else if is_case_ignorable c then preceded_by_cased rest
                 else false

let rec followed_by_cased (after:text) : Tot bool =
  match after with
  | [] -> false
  | c :: rest -> if is_cased c then true
                 else if is_case_ignorable c then followed_by_cased rest
                 else false

let rec lower_from (before:text) (s:text) : Tot text (decreases s) =
  match s with
  | [] -> []
  | c :: rest ->
      let mapped =
        if c = sigma_capital
        then (if preceded_by_cased before && not (followed_by_cased rest)
              then [sigma_final] else [sigma_small])
        else lower_one_context_free c in
      text_concat mapped (lower_from (c :: before) rest)

let rec text_uppercase (s:text) : Tot text =
  match s with
  | [] -> []
  | c :: rest -> text_concat (upper_one c) (text_uppercase rest)

let text_lowercase (s:text) : Tot text = lower_from [] s

let z10018_to_uppercase (input:text) : Tot text = text_uppercase input
let z10047_to_lowercase (input:text) : Tot text = text_lowercase input

(* Witnesses drawn from the corpus testers. *)
let upper_sharp_s_example () :
  Lemma (z10018_to_uppercase [0x74;0x73;0x63;0x68;0xFC;0xDF]
         == [0x54;0x53;0x43;0x48;0xDC;0x53;0x53]) =
  assert_norm (z10018_to_uppercase [0x74;0x73;0x63;0x68;0xFC;0xDF]
         == [0x54;0x53;0x43;0x48;0xDC;0x53;0x53])

let upper_georgian_example () :
  Lemma (z10018_to_uppercase [0x10D0;0x10FB;0x10FF] == [0x1C90;0x10FB;0x1CBF]) =
  assert_norm (z10018_to_uppercase [0x10D0;0x10FB;0x10FF] == [0x1C90;0x10FB;0x1CBF])

let upper_latin_ext_b_example () :
  Lemma (z10018_to_uppercase [0x2C65;0x2C66] == [0x023A;0x023E]) =
  assert_norm (z10018_to_uppercase [0x2C65;0x2C66] == [0x023A;0x023E])

let lower_dotted_i_example () :
  Lemma (z10047_to_lowercase [0x50;0x130;0x4A] == [0x70;0x69;0x307;0x6A]) =
  assert_norm (z10047_to_lowercase [0x50;0x130;0x4A] == [0x70;0x69;0x307;0x6A])

let lower_final_sigma_example () :
  Lemma (z10047_to_lowercase [0x1F48;0x394;0x3A5;0x3A3;0x3A3;0x395;0x38E;0x3A3]
         == [0x1F40;0x3B4;0x3C5;0x3C3;0x3C3;0x3B5;0x3CD;0x3C2]) =
  assert_norm (z10047_to_lowercase [0x1F48;0x394;0x3A5;0x3A3;0x3A3;0x395;0x38E;0x3A3]
         == [0x1F40;0x3B4;0x3C5;0x3C3;0x3C3;0x3B5;0x3CD;0x3C2])

let lower_bare_sigma_example () :
  Lemma (z10047_to_lowercase [0x3A3] == [0x3C3]) =
  assert_norm (z10047_to_lowercase [0x3A3] == [0x3C3])
