{
  "name": "wikifn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small revision-pinned Wikifunctions ZObject importer and composition evaluator.",
  "bin": {
    "wikifn": "./bin/wikifn.js"
  },
  "scripts": {
    "test": "node --test",
    "example": "node ./bin/wikifn.js eval-example",
    "example:trace": "node ./bin/wikifn.js eval-example --trace --profile",
    "analyze:demo": "node ./bin/wikifn.js analyze-demo",
    "fstar:check": "make fstar-check",
    "doctor": "make doctor"
  },
  "engines": {
    "node": ">=20"
  }
}
