{
  "name": "wikifn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small revision-pinned Wikifunctions ZObject importer and composition evaluator.",
  "bin": {
    "wikifn": "./bin/wikifn.js"
  },
  "scripts": {
    "test": "node --test",
    "example": "node ./bin/wikifn.js eval-example",
    "example:trace": "node ./bin/wikifn.js eval-example --trace --profile",
    "analyze:demo": "node ./bin/wikifn.js analyze-demo",
    "fstar:demo": "node ./bin/wikifn.js fstar-demo",
    "fstar:check": "make fstar-check",
    "fstar:ocaml": "make fstar-ocaml",
    "fstar:generate-compositions": "make fstar-generate-compositions",
    "fstar:js-demo": "make fstar-js-demo",
    "fstar:call-js": "make fstar-call-js",
    "fstar:call": "node ./bin/wikifn.js fstar-call --mode compiled Z10627 hello",
    "fstar:call-browser": "make fstar-call-browser",
    "fstar:browser-demo": "make fstar-browser-demo",
    "doctor": "make doctor",
    "dump:import": "make import-vendored-dump",
    "dump:download": "make download-dump"
  },
  "engines": {
    "node": ">=20"
  }
}
